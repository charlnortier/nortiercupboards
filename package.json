{
  "name": "nortier-cupboards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run check:hooks && npm run check:scope && npm run check:ci && npm run check:agents && npm run check:brief && npm run check:claude-md && npm run typecheck && npm run lint && npm run check:deadcode && npm run check:cycles",
    "check:agents": "node scripts/check-commands.mjs --selftest && node scripts/check-commands.mjs && node scripts/check-handoff-contract.mjs --selftest && node scripts/check-handoff-contract.mjs && node scripts/agent-distribution.mjs --selftest",
    "check:hooks": "node scripts/check-hook-registration.mjs && node .claude/hooks/bash-gate.probe.mjs && node .claude/hooks/canon-inbox.probe.mjs && node .claude/hooks/agent-write-scope.probe.mjs && node .claude/hooks/agent-brief-gate.probe.mjs && node scripts/check-context-budget.mjs",
    "check:brief": "node scripts/check-brief.mjs --selftest && node scripts/check-brief.mjs .",
    "check:claude-md": "node scripts/check-claude-md.mjs --selftest && node scripts/check-claude-md.mjs",
    "typecheck": "tsc --noEmit",
    "check:deadcode": "knip",
    "check:cycles": "madge --circular --extensions ts,tsx app components lib",
    "secrets": "node scripts/sync-secrets.mjs status",
    "secrets:pull": "node scripts/sync-secrets.mjs pull",
    "secrets:push": "node scripts/sync-secrets.mjs push",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:scope": "node scripts/check-scope.mjs --selftest && node scripts/check-scope.mjs --wired",
    "check:ci": "node scripts/check-ci.mjs --selftest && node scripts/check-ci.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "knip": "^6.42.1",
    "madge": "^8.0.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
